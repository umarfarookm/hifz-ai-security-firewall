{
  "name": "hifz-ai",
  "private": true,
  "version": "0.1.0",
  "description": "HIFZ — an agentic prompt injection firewall",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter=./packages/** run build && pnpm --filter=web run build",
    "dev": "pnpm --filter=web run dev",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "pnpm --filter=@hifz/eval run start",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.31.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
