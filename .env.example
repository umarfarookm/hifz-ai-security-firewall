# =============================================================================
# HIFZ — environment template
# Copy this file to `.env.local` and fill in the values you need.
# NEVER commit `.env.local` — it's already in .gitignore.
# Rule: nothing secret may start with NEXT_PUBLIC_ — that prefix ships to the browser.
# =============================================================================

# ---------- App ----------
NODE_ENV=development
APP_ENV=local                    # local | demo   (demo = deployed judge-facing build)

# ---------- LLM: provider selection (switchable per role) ----------
# Allowed: gemini | anthropic | openai | deepseek | ollama | none
# `none` = rules-only mode (useful for eval baselines and quota outages)
INVESTIGATOR_PROVIDER=gemini
INVESTIGATOR_MODEL=               # e.g. a Gemini Flash-Lite model — check the provider's docs for current model IDs
DEMO_AGENT_PROVIDER=gemini
DEMO_AGENT_MODEL=

LLM_TIMEOUT_MS=20000              # keep well under the platform's function timeout
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0                 # deterministic-as-possible verdicts
LLM_CACHE_ENABLED=true            # cache verdicts by content hash to protect free-tier quota

# ---------- LLM: provider credentials (fill in only the ones you use) ----------
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Ollama: LOCAL DEV / OFFLINE EVAL ONLY — a Vercel deployment cannot reach your laptop.
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Firewall policy ----------
# Risk score is 0–100. Bands map to decisions; only tune these against the eval set,
# and only on the tuning split.
RISK_THRESHOLD_MEDIUM=30          # >= → SANITIZE / MONITOR
RISK_THRESHOLD_HIGH=60            # >= → BLOCK or HUMAN REVIEW
RISK_THRESHOLD_CRITICAL=85        # >= → BLOCK
LLM_ESCALATION_BAND_MIN=20        # investigator is only called inside this band
LLM_ESCALATION_BAND_MAX=70
LLM_FAILURE_MODE=review           # review | block   (never "allow" on LLM failure)
SESSION_RISK_DECAY_MINUTES=30     # multi-step session risk window

# ---------- Supabase ----------
# Use the keys shown in your project dashboard (legacy anon/service_role
# or the newer publishable/secret naming — either works).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # public by design, protected by Row Level Security
SUPABASE_SERVICE_ROLE_KEY=        # SERVER ONLY — bypasses RLS, never expose this

# ---------- Public demo protection ----------
RATE_LIMIT_PER_IP_PER_MIN=10

# ---------- Synthetic secrets for the demo agent (FAKE values only — never real credentials) ----------
DEMO_FAKE_API_KEY=sk-hifz-demo-000000000000
DEMO_FAKE_DB_PASSWORD=hifz-demo-password
